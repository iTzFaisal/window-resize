<Window x:Class="WindowSizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowSizer"
        Width="1000"
        Height="760"
        MinWidth="850"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB"
        Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="WindowSizer" FontSize="27" FontWeight="Bold" />
                <TextBlock Margin="0,5,0,0"
                           Text="Resize an open window to a preset or a percentage of its display."
                           FontSize="14"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource QuietButtonStyle}"
                    Click="Refresh_Click"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↻" FontSize="17" Margin="0,0,8,0" />
                    <TextBlock Text="Refresh windows" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.02*" />
                <ColumnDefinition Width="1.18*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="15"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="WindowCountText"
                                   DockPanel.Dock="Right"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="Open windows" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Choose the window you want to resize."
                                       Margin="0,3,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,15,0,0">
                        <ListBox x:Name="WindowList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemContainerStyle="{StaticResource WindowListItemStyle}"
                                 SelectionChanged="WindowList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ProcessAndSize}"
                                                   Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyWindowsText"
                                   Text="No visible windows found. Try refreshing."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="20"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="17,0,0,0"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="15"
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Selected window" FontSize="17" FontWeight="SemiBold" />
                        <Border Margin="0,12,0,0"
                                Padding="13"
                                Background="#F7F9FD"
                                BorderBrush="#EDF1F7"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock x:Name="SelectedTitleText"
                                           Text="Select a window"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SelectedProcessText"
                                           Text="Window details will appear here."
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12" />
                                <TextBlock x:Name="CurrentSizeText"
                                           Text="Current client area: —"
                                           Margin="0,11,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="DisplayResolutionText"
                                           Text="Display resolution: —"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Choose a size"
                                   Margin="0,19,0,10"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <Grid x:Name="PresetPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Grid.Column="0" Tag="1280,720" Click="Preset_Click"
                                    Style="{StaticResource QuietButtonStyle}" HorizontalContentAlignment="Left"
                                    Margin="0,0,5,6" Padding="12,9">
                                <StackPanel>
                                    <TextBlock Text="720p" FontWeight="SemiBold" />
                                    <TextBlock Text="1280 × 720" Margin="0,2,0,0" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="0" Grid.Column="1" Tag="1920,1080" Click="Preset_Click"
                                    Style="{StaticResource QuietButtonStyle}" HorizontalContentAlignment="Left"
                                    Margin="5,0,0,6" Padding="12,9">
                                <StackPanel>
                                    <TextBlock Text="1080p" FontWeight="SemiBold" />
                                    <TextBlock Text="1920 × 1080" Margin="0,2,0,0" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="0" Tag="2560,1440" Click="Preset_Click"
                                    Style="{StaticResource QuietButtonStyle}" HorizontalContentAlignment="Left"
                                    Margin="0,0,5,0" Padding="12,9">
                                <StackPanel>
                                    <TextBlock Text="1440p" FontWeight="SemiBold" />
                                    <TextBlock Text="2560 × 1440" Margin="0,2,0,0" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="1" Tag="3840,2160" Click="Preset_Click"
                                    Style="{StaticResource QuietButtonStyle}" HorizontalContentAlignment="Left"
                                    Margin="5,0,0,0" Padding="12,9">
                                <StackPanel>
                                    <TextBlock Text="2160p" FontWeight="SemiBold" />
                                    <TextBlock Text="3840 × 2160" Margin="0,2,0,0" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Height="1" Background="#EDF1F7" Margin="0,16,0,14" />

                        <TextBlock Text="Scale to display resolution"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Enter a percentage; width and height scale together."
                                   Margin="0,4,0,10"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" />
                        <Grid x:Name="PercentagePanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PercentageBox"
                                     TextChanged="PercentageBox_TextChanged"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     ToolTip="Enter a percentage from 0.1 to 1000." />
                            <TextBlock Grid.Column="1"
                                       Text="%"
                                       Margin="11,0,4,0"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" />
                        </Grid>

                        <Border Margin="0,12,0,0"
                                Padding="14,12"
                                Background="#F0F4FF"
                                BorderBrush="#E1E9FF"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="LIVE CLIENT-AREA PREVIEW"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#5973BA" />
                                <TextBlock x:Name="PreviewText"
                                           Text="Choose a preset or enter a percentage"
                                           Margin="0,5,0,0"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="PreviewBasisText"
                                           Text="The preview is shown in pixels."
                                           Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="ResizeButton"
                                Content="Resize selected window"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,14,0,2"
                                IsEnabled="False"
                                Click="Resize_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,15,0,0"
                Padding="12,9"
                Background="#EEF2F8"
                CornerRadius="9">
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       FontSize="11"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
